# Окружение тестового стенда RDM (Raspberry Pi 5 / ARM64)
# Скопируйте этот файл в .env.stage и задайте реальные значения перед запуском:
#   cp deploy/stage/env.stage.example .env.stage
#   chmod 600 .env.stage

# Режим приложения и базовые параметры
APP_ENV=stage
APP_NAME=Remote Desktop Manager
APP_SECRET_KEY=CHANGE_ME_APP_SECRET_KEY

# База данных PostgreSQL (контейнер postgres в docker-compose)
POSTGRES_DB=rdm
POSTGRES_USER=nimda
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://nimda:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/rdm

# Redis и очереди Celery (контейнер redis в docker-compose)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Доверенные источники для CORS (origin браузера: локальный хост RPi, домен или порт)
# Пример для доступа по локальной сети: http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.100:8080
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Интеграция с Omnidesk (API)
OMNIDESK_BASE_URL=https://iridi.omnidesk.ru
OMNIDESK_STAFF_EMAIL=
OMNIDESK_API_KEY=CHANGE_ME_OMNIDESK_API_KEY
OMNIDESK_TIMEOUT_SECONDS=5.0
# Omnidesk не ищет обращения по публичному номеру, поэтому при промахе в локальном
# индексе читаются недавно изменённые обращения (только чтение) и сохраняются в индекс.
OMNIDESK_CASE_LAZY_LOOKUP_ENABLED=true
OMNIDESK_CASE_LAZY_LOOKUP_DAYS=7
OMNIDESK_CASE_LAZY_LOOKUP_MAX_PAGES=5

# Интеграция с Telegram и Битрикс24
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_API_URL=https://api.telegram.org
BITRIX24_BOT_WEBHOOK_URL=CHANGE_ME_BITRIX24_BOT_WEBHOOK_URL
BITRIX24_BOT_ID=
BITRIX24_BOT_CLIENT_ID=

# Базовые URL для ссылок в уведомлениях и отмены
# ВНИМАНИЕ: Для работы клиентской отмены и фрейма требуется доверенный HTTPS origin
# Например: https://stage-rdm.example.com
NOTIFICATION_CARD_BASE_URL=
CANCELLATION_PUBLIC_BASE_URL=

# Параметры доставки уведомлений
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_SECONDS=60
NOTIFICATION_LOCK_SECONDS=300
NOTIFICATION_HTTP_TIMEOUT_SECONDS=5.0

# Внешняя доставка и сканер напоминаний (на стенде по умолчанию ВЫКЛЮЧЕНЫ для безопасности)
NOTIFICATION_DELIVERY_ENABLED=false
REMINDER_SCANNER_ENABLED=false
# Запись в Omnidesk (заметки, назначения, предупреждения клиенту, ссылки отмены).
# Без этого флага worker пишет в реальные тикеты каждые 10 секунд, если заданы ключи Omnidesk.
OMNIDESK_OUTBOX_DELIVERY_ENABLED=false

# Интервалы напоминаний и эскалаций
REMINDER_L2_INTERVAL_SECONDS=600
REMINDER_L2_ESCALATION_AFTER_COUNT=2
REMINDER_L1_INTERVAL_SECONDS=600
REMINDER_L1_ESCALATION_AFTER_COUNT=2
REMINDER_L1_MANAGER_REPEAT_SECONDS=1800
REMINDER_L1_INFORMED_INTERVAL_SECONDS=1800
REMINDER_SCAN_INTERVAL_SECONDS=60
REMINDER_BATCH_SIZE=100
