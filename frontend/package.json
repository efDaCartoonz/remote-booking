    "vue-tsc": "^2.1.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.62.1",
    "vitest": "^5.0.1"
  }
